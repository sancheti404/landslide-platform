# Uttarakhand Landslide Intelligence Platform - Frontend Environment Config
# Copy this file to .env and provide your credentials.
# NEVER commit .env to version control.

# Google Maps JavaScript API Key (Optional for development; fallback mock map activates if empty)
VITE_GOOGLE_MAPS_API_KEY=

# Spring Boot API Gateway Base URL (Defaults to empty string to leverage Vite dev proxy /api)
VITE_API_BASE_URL=
